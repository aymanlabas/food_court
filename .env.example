# ============================================
# Food-Court Environment Configuration
# Copy this file to .env and fill in your values
# ============================================

# PostgreSQL Global
POSTGRES_USER=foodcourt
POSTGRES_PASSWORD=your_secure_password_here

# Database - Menu
DB_MENU_NAME=db_menu
DB_MENU_URL=jdbc:postgresql://postgres:5432/db_menu
DB_MENU_USERNAME=foodcourt
DB_MENU_PASSWORD=your_secure_password_here

# Database - Commandes
DB_COMMANDES_NAME=db_commandes
DB_COMMANDES_URL=jdbc:postgresql://postgres:5432/db_commandes
DB_COMMANDES_USERNAME=foodcourt
DB_COMMANDES_PASSWORD=your_secure_password_here

# Database - Usagers
DB_USAGERS_NAME=db_usagers
DB_USAGERS_URL=jdbc:postgresql://postgres:5432/db_usagers
DB_USAGERS_USERNAME=foodcourt
DB_USAGERS_PASSWORD=your_secure_password_here

# Database - Notification
DB_NOTIFICATION_NAME=db_notification
DB_NOTIFICATION_URL=jdbc:postgresql://postgres:5432/db_notification
DB_NOTIFICATION_USERNAME=foodcourt
DB_NOTIFICATION_PASSWORD=your_secure_password_here

# JWT
JWT_SECRET=your_jwt_secret_key_at_least_64_characters_long_for_hs512_algorithm
JWT_EXPIRATION=86400000

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password_here

# RabbitMQ (V5)
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=foodcourt
RABBITMQ_PASSWORD=your_rabbitmq_password_here

# Kafka (V7)
KAFKA_BOOTSTRAP_SERVERS=kafka:9092

# Service Ports
SERVICE_MENU_PORT=8081
SERVICE_COMMANDES_PORT=8082
SERVICE_USAGERS_PORT=8083
SERVICE_NOTIFICATION_PORT=8084
GATEWAY_PORT=8080

# Frontend
VITE_API_URL=http://localhost:8080/api

